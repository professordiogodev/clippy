# Copy to .env and edit:  cp .env.example .env
# Never commit a real .env file. It is in .gitignore.

# --- Application ---------------------------------------------------------
# Version string reported by /healthz and in the logs. The release pipeline sets it to the image tag.
APP_VERSION=0.2.0
# Public base URL used to build short links.
BASE_URL=http://localhost:8000
# Used only by `python -m api`. With uvicorn you pass --host and --port instead.
APP_HOST=0.0.0.0
APP_PORT=8000
# debug | info | warn | error
LOG_LEVEL=info
# json (one JSON object per line, for log pipelines) or text (readable while developing)
LOG_FORMAT=json

# --- Limits ---------------------------------------------------------------
MAX_URL_LENGTH=2048
CODE_LENGTH=6

# --- Backing services (optional) -------------------------------------------
# Leave empty to run with the in-memory store (data is lost on restart and is per process).
# PostgreSQL, for persistence:   postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
# Redis, to cache redirects:     redis://HOST:6379
REDIS_URL=
# How long a redirect stays in the cache.
CACHE_TTL_SECONDS=300
